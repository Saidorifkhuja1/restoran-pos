# Database
DATABASE_URL="postgresql://user:password@localhost:5432/restorpos?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/restorpos?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3001"
PUBLIC_APP_URL="http://localhost:5173"

# Frontend
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,https://your-frontend.vercel.app"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRATION="24h"

# Pusher (Realtime)
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="mt1"

# Redis
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PROD_REDIS_ONLY=false

# Cloudinary (File upload)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Payment providers
PAYMENT_WEBHOOK_SECRET="generic-webhook-secret"
CLICK_SECRET_KEY=""
PAYME_SECRET_KEY=""
UZUM_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Queue / workers
REPORT_QUEUE_NAME="reports"
REPORT_EXPORT_DIR=".data/report-exports"

# Email (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Node env
NODE_ENV="development"
SKIP_ENV_VALIDATION="true"
